# Database (required in production — any Postgres: Railway, Neon, ...). For local PGlite:
#   DATABASE_URL=pglite
#   or a custom data dir: DATABASE_URL=pglite:.pglite
#   or: yarn workspace web dev:pglite
# Also used by `yarn db:generate` and `yarn db:push` (PGlite when set to pglite).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Trading telemetry (read-only balance/equity history)
MONGODB_URL=mongodb+srv://user:password@host/?retryWrites=true&w=majority

# Cache — telemetry metrics are cached for 5 minutes (optional; skipped if unset)
REDIS_URL=redis://default:password@host:6379

# Auth (required in production — set BETTER_AUTH_URL to the app's public URL)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://partners.ft9ja.com

# Client IP for rate limiting / admin guards. Set only on a platform whose edge overwrites
# this header (Railway: x-real-ip). Unset = rightmost X-Forwarded-For hop (Heroku).
TRUSTED_CLIENT_IP_HEADER=

# Partner admin session signing (optional — falls back to BETTER_AUTH_SECRET in dev)
PARTNER_ADMIN_SESSION_SECRET=

# Trader password-setup token signing (optional — falls back to BETTER_AUTH_SECRET in dev)
TRADER_SETUP_TOKEN_SECRET=

# Public routing
NEXT_PUBLIC_ROOT_DOMAIN=ft9ja.com
NEXT_PUBLIC_APP_URL=https://ft9ja.com

# Email (required for outbound app email via SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=FT9ja <accounts@ft9ja.com>
SENDGRID_FT9JA_PARTNER_FROM_EMAIL=FT9ja Partners <accounts@ft9ja.com>
SENDGRID_REPLY_TO_EMAIL=accounts@ft9ja.com

# Object storage (receipts, KYC documents, partner logos). Private bucket: reads go through
# presigned URLs or /api/partners/[slug]/logo. AWS_S3_BUCKET is the bucket name on S3 and on R2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=

# Cloudflare R2 switch. When R2_ENDPOINT is set, storage uses R2's S3 API (region auto) with the
# R2_* keys instead of AWS S3 and the AWS_* keys. Leave R2_ENDPOINT empty to stay on S3.
# e.g. R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OpenAI (required for partner AI logo generation)
OPENAI_API_KEY=

CRON_SECRET=

